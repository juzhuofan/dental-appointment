server:
  address: 127.0.0.1
  port: 8080

spring:
  application:
    name: dental-appointment
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 11MB
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/dental_appointment?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
    username: dental_app
    password: CHANGE_ME_DATABASE_PASSWORD
    hikari:
      maximum-pool-size: 5
      minimum-idle: 1
      transaction-isolation: TRANSACTION_READ_COMMITTED
  data:
    redis:
      host: 127.0.0.1
      port: 6379
      password: CHANGE_ME_REDIS_PASSWORD
      timeout: 1500ms
      connect-timeout: 1500ms
  jackson:
    time-zone: UTC
    serialization:
      write-dates-as-timestamps: false
  flyway:
    enabled: true
    locations: classpath:db/migration

mybatis-plus:
  mapper-locations: classpath*:mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

app:
  ai:
    enabled: false
    base-url: https://api.deepseek.com
    api-key: CHANGE_ME_DEEPSEEK_API_KEY
    model: deepseek-flash
    temperature: 0.1
    max-tokens: 1024
    connect-timeout: 3s
    read-timeout: 25s
    max-concurrent-calls: 2
    requests-per-minute: 10
  wechat:
    enabled: true
    app-id: CHANGE_ME_WECHAT_APP_ID
    app-secret: CHANGE_ME_WECHAT_APP_SECRET
  oss:
    enabled: true
    endpoint: https://oss-cn-beijing.aliyuncs.com
    region: cn-beijing
    bucket-name: dental-backend
    access-key-id: CHANGE_ME_OSS_ACCESS_KEY_ID
    access-key-secret: CHANGE_ME_OSS_ACCESS_KEY_SECRET
    public-base-url: ''
    object-prefix: dental/uploads
    max-file-size: 10MB
    allowed-extensions: [jpg, jpeg, png, gif, webp, pdf, doc, docx, xls, xlsx, txt, csv, zip]
  jwt:
    secret: CHANGE_ME_RANDOM_JWT_SECRET_MINIMUM_32_BYTES
    access-token-minutes: 480
  demo-login:
    enabled: false
  cors-origins: https://CHANGE_ME_ADMIN_DOMAIN

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: never

springdoc:
  api-docs:
    path: /v3/api-docs

logging:
  level:
    com.dental: INFO
