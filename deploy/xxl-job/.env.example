# REQUIRED: copy to .env and fill with unique credentials before starting Compose.
# Do not commit .env. Admin password: 12-20 characters. Database passwords: 12+ characters.
# Use distinct passwords and a 32+ character random executor token.
# Admin username: 4-20 ASCII letters, digits, dots, underscores or hyphens.
XXL_JOB_MYSQL_ROOT_PASSWORD=
XXL_JOB_DB_PASSWORD=
XXL_JOB_ADMIN_USERNAME=
XXL_JOB_ADMIN_PASSWORD=
XXL_JOB_EXECUTOR_ACCESS_TOKEN=

# Must match backend XXL_JOB_EXECUTOR_APPNAME. First initialization creates its group and a stopped weekly job.
XXL_JOB_EXECUTOR_APPNAME=dental-appointment-executor
XXL_JOB_ADMIN_PORT=18080

# For the host-run backend (set in its IDE/process environment; Compose does not start the business backend).
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:18080
XXL_JOB_EXECUTOR_ENABLED=false
XXL_JOB_EXECUTOR_PORT=9999
XXL_JOB_EXECUTOR_ADDRESS=http://host.docker.internal:9999/
